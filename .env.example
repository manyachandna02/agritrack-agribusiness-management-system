# Copy this file to server/.env and fill in real values.
# Never commit the actual .env file.

# Server
PORT=5000

# MongoDB (local example: mongodb://127.0.0.1:27017/agritrack)
MONGODB_URI=

# JWT (used starting Phase 2 — Authentication)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Initial admin seed account (used starting Phase 2 — Authentication)
ADMIN_EMAIL=
ADMIN_PASSWORD=
